# ============================================================================
#  Payment Reconciliation API
#  Copy to .env. NEVER commit .env.
# ============================================================================

# local | dev | test | prod
#   local -> auth optional, /docs on, CORS relaxed
#   anything else -> API_KEY and CORS_ORIGINS become MANDATORY (refuses to boot)
ENVIRONMENT=local

AZURE_TABLE=summarylogs

# --- storage credential: pick ONE --------------------------------------------
# (a) LOCAL: connection string. Portal > Access keys > key1 > Connection string
AZURE_STORAGE_CONNECTION_STRING=

# (b) AZURE: managed identity — no key to leak or rotate. Set the account name
#     only, leave the connection string blank, and grant the app's identity the
#     "Storage Table Data Reader" role on the storage account.
AZURE_STORAGE_ACCOUNT=

# --- API auth ----------------------------------------------------------------
# Blank is allowed ONLY when ENVIRONMENT=local. Min 24 chars otherwise.
#   generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Exact origins allowed to call this API. Required outside local; '*' refused.
#   e.g. https://recon.example.com
CORS_ORIGINS=

# --- behaviour ---------------------------------------------------------------
CACHE_TTL_SECONDS=60
# latest = most recent run per vendor per day wins. Confirmed correct for
# summarylogs: re-runs carry identical figures. first | sum also available.
DEDUP_STRATEGY=latest
